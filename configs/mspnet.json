{
  "data_root": "data/hfz3",
  "split_dir": "data/hfz3/splits_spatial_uavtrain",
  "out_dir": "outputs/mspnet",
  "label_mode": "triclass",
  "epochs": 100,
  "batch_size": 8,
  "lr": 0.001,
  "base": 24,
  "seed": 2026,
  "augment_factor": 2,
