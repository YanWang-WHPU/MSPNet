  "prototype_input": true,
  "ground_prototype_ratio": 0.2,
  "boundary_weight": 0.05,
  "teacher_boundary_dir": "teacher_boundaries_soft",
  "teacher_valid_dir": "teacher_valid",
  "selection_metric": "mIoU"
}
